{
  "rules": {
    ".read": false,
    ".write": false,
    "esp8266": {
      ".read": "auth != null",
      ".write": "auth != null",
      "temperature": { ".validate": "newData.isNumber() && newData.val() >= -40 && newData.val() <= 80" },
      "humidity": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
      "soilMoisture": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
      "lightLevel": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
      "airQuality": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
      "lastUpdate": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
      "$device": {
        "control": { ".validate": "newData.isString() && (newData.val() === 'ON' || newData.val() === 'OFF')" },
        "status": { ".validate": "newData.isString() && (newData.val() === 'ON' || newData.val() === 'OFF')" }
      }
    },
    "settings": {
      ".read": "auth != null",
      ".write": "auth != null",
      "autoMode": { ".validate": "newData.isBoolean()" }
    },
    "history": {
      ".read": "auth != null",
      ".write": false,
      ".indexOn": ["timestamp"]
    },
    "alerts": {
      ".read": "auth != null",
      ".write": false
    }
  }
}
